# Garmin credentials are only needed for the first-time `garmin-mcp auth login`.
# After tokens are persisted, the server runs without these.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=
# If set, used non-interactively as the MFA code during `auth login`.
GARMIN_MFA=

# Where to read/write OAuth tokens. Defaults to ~/.config/garmin-mcp/tokens.
GARMIN_TOKENS_PATH=

# Transport: "stdio" (default) or "http".
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# When MCP_TRANSPORT=http and this is set, the server requires
# `Authorization: Bearer <token>` on every request.
MCP_BEARER_TOKEN=

# Set to "1" to disable in-process TTL caching of Garmin responses.
GARMIN_MCP_NO_CACHE=
